# Copy to .env.local outside Git or export these variables.
TUBO_E2E_RELAY_HOST=tuborelay
TUBO_E2E_PUBLISHER_HOST=oripi
TUBO_E2E_CLIENT_HOST=local
TUBO_E2E_RELAY_PUBLIC_IP=172.232.189.160
TUBO_E2E_REMOTE_GOARCH=amd64
TUBO_E2E_RELAY_PORT=44001
TUBO_E2E_HTTP_PORT=18080
TUBO_E2E_CLIENT_PORT=18999
# periodic-sync uses two membership-backed contenders in one local client home.
TUBO_E2E_SYNC_A_PORT=19001
TUBO_E2E_SYNC_B_PORT=19002
# Optional bounded polling overrides, in seconds.
TUBO_E2E_SYNC_TAKEOVER_TIMEOUT=65
TUBO_E2E_SYNC_OUTAGE_TIMEOUT=120
TUBO_E2E_SYNC_RECOVERY_TIMEOUT=180
# Required for mutating scenarios:
# TUBO_E2E_CONFIRM=three-machine
